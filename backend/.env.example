FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=true

CORS_ORIGIN=http://localhost:5173
WHISPER_MODEL=base
UPLOAD_DIR=uploads
MAX_CONTENT_LENGTH_MB=25

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# MinerU 直接使用內部 Python 套件，不需要獨立 HTTP 服務
# MINERU_BACKEND=hybrid-auto-engine
MINERU_BACKEND=pipeline
MINERU_LANG_LIST=ch
MINERU_PARSE_METHOD=auto
MINERU_MODEL=mineru-default

GOOGLE_CLIENT_ID=

# 忘記密碼寄信用的 SMTP 設定，留空時重設連結只會印到後端 log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
